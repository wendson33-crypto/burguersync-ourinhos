{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PedidoBurguerSync",
  "description": "Esquema canônico de validação para pedidos no Firestore",
  "type": "object",
  "required": ["cliente", "itens", "pagamento", "valores", "status"],
  "properties": {
    "cliente": {
      "type": "object",
      "required": ["nome", "celular", "endereco"],
      "properties": {
        "nome": { "type": "string", "minLength": 2 },
        "email": { "type": "string" },
        "celular": { "type": "string", "minLength": 8 },
        "endereco": { "type": "string", "minLength": 5 },
        "obsEntrega": { "type": "string" }
      }
    },
    "itens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["nome", "preco", "quantidade"],
        "properties": {
          "id": { "type": ["number", "string"] },
          "nome": { "type": "string" },
          "preco": { "type": "number" },
          "quantidade": { "type": "integer", "minimum": 1 },
          "pontoCarne": { "type": "string" },
          "adicionais": { "type": "array", "items": { "type": "string" } },
          "remocoes": { "type": "array", "items": { "type": "string" } },
          "obsItem": { "type": "string" }
        }
      }
    },
    "pagamento": {
      "type": "object",
      "required": ["metodo"],
      "properties": {
        "metodo": {
          "type": "string",
          "enum": ["Pix", "Cartao_Entrega", "Dinheiro_Entrega", "pix", "cartao", "dinheiro"]
        },
        "trocoPara": { "type": "string" }
      }
    },
    "valores": {
      "type": "object",
      "required": ["subtotal", "taxaEntrega", "total"],
      "properties": {
        "subtotal": { "type": "number" },
        "taxaEntrega": { "type": "number" },
        "total": { "type": "number" }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "Recebido", "recebido",
        "Em Preparo", "preparo",
        "Saiu para Entrega", "entrega",
        "Entregue", "concluido"
      ]
    },
    "horario": { "type": "string" },
    "criadoEm": { "type": ["string", "object"] }
  }
}
